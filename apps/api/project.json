{
  "name": "api",
  "targets": {
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "api:build",
        "runtimeArgs": ["-r", "tsconfig-paths/register"]
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "main": "apps/api/src/server.ts",
        "outputPath": "dist/apps/api",
        "tsConfig": "apps/api/tsconfig.json"
      }
    }
  }
}
