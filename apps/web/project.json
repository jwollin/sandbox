{
  "name": "web",
  "projectType": "application",
  "root": "apps/web",
  "tags": ["web", "next", "ts", "typescript"],
  "targets": {
    "dev": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "@sandbox/app:build",
        "dev": true
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "production",
      "options": {
        "buildTarget": "@sandbox/app:build",
        "dev": true
      }
    },
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/sandbox"
      },
      "configurations": {
        "production": {
          "outputPath": "dist/apps/sandbox",
          "optimization": true
        },
        "development": {
          "outputPath": "dist/apps/sandbox",
          "optimization": false
        }
      }
    }
  }
}
