{
  "name": "sandbox",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "module": "commonjs",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "nx run-many -t dev --parallel",
    "build": "nx run-many -t build",
    "test": "jest",
    "lint": "nx run-many -t lint",
    "build:api": "cross-env NODE_ENV=production tsup apps/api/src/server.ts",
    "dev:api": "cross-env NODE_ENV=development tsx apps/api/src/server.ts --watch",
    "dev:sandbox": "cross-env NODE_ENV=development PORT=8282",
    "plop": "plop",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "start:api": "cross-env NODE_ENV=production node dist/server.js",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
