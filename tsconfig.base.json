{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "paths": {
      "@routes/*": ["apps/apis/node/src/routes/*"],
      "@utils/*": ["apps/apis/node/src/utils/*"],
      "@middleware/*": ["apps/apis/node/src/middleware/*"],
      "@services/*": ["apps/apis/node/src/services/*"],
      "@errors/*": ["apps/apis/node/src/errors/*"],
      "@config/*": ["./config/src/index.ts"],
      "@shared/*": ["./libs/shared/src/index.ts"]
    }
  }
}
